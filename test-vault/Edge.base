filters:
  or:
    - file.inFolder("Recipes")
    - file.inFolder("Edge")
views:
  - type: split-groups
    name: By category (links, case, duplicates)
    order:
      - file.name
      - category
      - tags
    splitBy: note.category
  - type: split-groups
    name: By tags
    order:
      - file.name
      - tags
    splitBy: note.tags
  - type: split-groups
    name: By servings (numbers)
    order:
      - file.name
      - servings
    splitBy: note.servings
