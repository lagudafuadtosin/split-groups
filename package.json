{
  "name": "split-groups",
  "version": "0.1.1",
  "description": "An Obsidian Bases view that puts a note in every group its list property names.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "esbuild test/groups.test.ts --bundle --platform=node --format=esm --outfile=.test-build/groups.test.mjs --log-level=warning && node --test .test-build/groups.test.mjs",
    "bulk": "node scripts/make-bulk-notes.mjs"
  },
  "author": "Fuad Laguda",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.6.0"
  }
}
